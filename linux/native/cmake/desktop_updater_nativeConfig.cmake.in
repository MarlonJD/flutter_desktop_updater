include(CMakeFindDependencyMacro)
find_dependency(OpenSSL REQUIRED COMPONENTS Crypto)
if("@DESKTOP_UPDATER_NATIVE_RUNTIME_BUILT@" STREQUAL "ON")
  find_dependency(CURL REQUIRED)
  find_dependency(Threads REQUIRED)
endif()
get_filename_component(desktop_updater_native_PREFIX
  "${CMAKE_CURRENT_LIST_DIR}/@DESKTOP_UPDATER_CMAKE_PREFIX_FROM_CONFIGDIR@"
  ABSOLUTE)
set(desktop_updater_native_HELPER_EXECUTABLE
  "${desktop_updater_native_PREFIX}/@CMAKE_INSTALL_LIBEXECDIR@/desktop-updater-helper")
include("${CMAKE_CURRENT_LIST_DIR}/desktop_updater_nativeTargets.cmake")
