<Project>
  <ItemGroup>
    <DesktopUpdaterNativeRuntime
      Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\desktop_updater_native.dll" />
    <DesktopUpdaterNativeRuntime
      Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\desktop_updater_runtime.dll" />
  </ItemGroup>

  <Target Name="CopyDesktopUpdaterNativeRuntime" AfterTargets="Build">
    <Error
      Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'"
      Text="DesktopUpdater.Native supports only RuntimeIdentifier 'win-x64'; received '$(RuntimeIdentifier)'." />
    <Error
      Condition="!Exists('%(DesktopUpdaterNativeRuntime.Identity)')"
      Text="DesktopUpdater.Native package is missing %(DesktopUpdaterNativeRuntime.Identity)." />
    <Copy
      SourceFiles="@(DesktopUpdaterNativeRuntime)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
