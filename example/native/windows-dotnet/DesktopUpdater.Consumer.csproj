<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <DesktopUpdaterNativeVersion Condition="'$(DesktopUpdaterNativeVersion)' == ''">0.0.0-local</DesktopUpdaterNativeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DesktopUpdater.Native" Version="$(DesktopUpdaterNativeVersion)" />
  </ItemGroup>
</Project>
