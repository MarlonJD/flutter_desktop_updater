        ]
      },
      "expectedValid": false
    }
  ],
  "versionComparisons": [
    {
      "name": "newer build number wins",
      "candidate": "2.7.0+271",
      "current": "2.7.0+270",
      "expectedSign": 1
    },
    {
      "name": "older build number loses",
      "candidate": "3.0.0+100",
      "current": "2.7.0+270",
      "expectedSign": -1
    },
    {
      "name": "stable follows prerelease",
      "candidate": "2.8.0",
      "current": "2.8.0-beta.1",
      "expectedSign": 1
    },
    {
      "name": "prerelease precedes stable",
      "candidate": "2.8.0-beta.1",
      "current": "2.8.0",
      "expectedSign": -1
    }
  ],
